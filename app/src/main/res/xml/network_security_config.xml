<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow the BTS API domain even with self-signed certs in dev -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">bts-audit.tailfd1512.ts.net</domain>
        <domain includeSubdomains="true">tailfd1512.ts.net</domain>
    </domain-config>
</network-security-config>
